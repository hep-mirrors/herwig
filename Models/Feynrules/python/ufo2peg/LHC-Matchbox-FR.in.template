# -*- ThePEG-repository -*-

##################################################
## Herwig/Matchbox example input for ufo2herwig
##################################################

##################################################
## Collider type
##################################################

read snippets/Matchbox.in
read snippets/PPCollider.in

##################################################
## Beam energy sqrt(s)
##################################################

cd /Herwig/EventHandlers
set EventHandler:LuminosityFunction:Energy 13000*GeV

##################################################
## Process selection
##################################################

## Model assumptions
read Matchbox/StandardModelLike.in
read Matchbox/NonDiagonalCKM.in
read ${ModelName}.model

## Set the order of the couplings
cd /Herwig/MatrixElements/Matchbox
set Factory:OrderInAlphaS 0
set Factory:OrderInAlphaEW 2

## Select the process
## You may use identifiers such as ${BSM_Particles_list}.
do Factory:Process p p -> [PARTICLE1_NAME] [PARTICLE2_NAME]

${BSM_HardProcessWidth}

## Special settings required for on-shell production of unstable particles
## enable for on-shell top production
# read Matchbox/OnShellTopProduction.in
## enable for on-shell W, Z or h production
# read Matchbox/OnShellWProduction.in
# read Matchbox/OnShellZProduction.in
# read Matchbox/OnShellHProduction.in
# Special settings for the VBF approximation
# read Matchbox/VBFDiagramsOnly.in

# cd /Herwig/MatrixElements/Matchbox/Utility
# insert DiagramGenerator:RestrictLines 0 /Herwig/Particles/W+
# insert DiagramGenerator:RestrictLines 0 /Herwig/Particles/W-
# insert DiagramGenerator:RestrictLines 0 /Herwig/Particles/Z0
# insert DiagramGenerator:RestrictLines 0 /Herwig/Particles/gamma
# do DiagramGenerator:SpaceLikeRange 0 0
# do DiagramGenerator:TimeLikeRange 0 0
# do DiagramGenerator:ClearRestrictLines

##################################################
## Matrix element library selection
##################################################

read Matchbox/MadGraph-MadGraph.in

cd /Herwig/MatrixElements/Matchbox/Amplitudes
set MadGraph:Model ${ModelAbsPath}

##################################################
## Cut selection
## See the documentation for more options
##################################################

# cd /Herwig/Cuts/
# set ChargedLeptonPairMassCut:MinMass 60*GeV
# set ChargedLeptonPairMassCut:MaxMass 120*GeV

## cuts on additional jets

# read Matchbox/DefaultPPJets.in

# insert JetCuts:JetRegions 0 FirstJet
# insert JetCuts:JetRegions 1 SecondJet
# insert JetCuts:JetRegions 2 ThirdJet
# insert JetCuts:JetRegions 3 FourthJet

##################################################
## Scale choice
## See the documentation for more options
##################################################

cd /Herwig/MatrixElements/Matchbox
set Factory:ScaleChoice Scales/SHatScale
# set Scales/FixedScale:FixedScale 91.188*GeV
# set Factory:ScaleChoice Scales/FixedScale
set /Herwig/Samplers/Sampler:Verbose No

##################################################
## Matching and shower selection
## Please also see flavour scheme settings
## towards the end of the input file.
##################################################

read Matchbox/LO-DefaultShower.in
# read Matchbox/LO-DipoleShower.in
# read Matchbox/LO-NoShower.in

${read_Couplings}

##################################################
## Scale uncertainties
##################################################

# read Matchbox/MuDown.in
# read Matchbox/MuUp.in

##################################################
## Shower scale uncertainties
##################################################

# read Matchbox/MuQDown.in
# read Matchbox/MuQUp.in

##################################################
## PDF choice
##################################################

read Matchbox/FiveFlavourScheme.in
## required for dipole shower and fixed order in five flavour scheme
# read Matchbox/FiveFlavourNoBMassScheme.in
read Matchbox/CT14.in
# read Matchbox/MMHT2014.in

##################################################
## Analyses
##################################################

# read snippets/HepMC.in
# set /Herwig/Analysis/HepMC:PrintEvent 1000000
# set /Herwig/Analysis/HepMC:Format GenEvent
# set /Herwig/Analysis/HepMC:Units GeV_mm

cd /Herwig/Analysis
# insert Rivet:Analyses 0 XXX_2015_ABC123
# insert /Herwig/Generators/EventGenerator:AnalysisHandlers 0 Rivet

# insert /Herwig/Generators/EventGenerator:AnalysisHandlers 0 HepMC
# set /Herwig/Analysis/HepMC:PrintEvent 1000000
# set /Herwig/Analysis/HepMC:Format GenEvent
# set /Herwig/Analysis/HepMC:Units GeV_mm

##################################################
## Save the generator
##################################################

do /Herwig/MatrixElements/Matchbox/Factory:ProductionMode

cd /Herwig/Generators
saverun LHC-Matchbox-${ModelName} EventGenerator

