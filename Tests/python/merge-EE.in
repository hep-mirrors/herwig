# ARGUS_1988_I266892 baryon correlations
useOne("/ARGUS_1988_I266892/d01-x01-y01","9.98")
useOne("/ARGUS_1988_I266892/d01-x01-y02","U1" )
useOne("/ARGUS_1988_I266892/d02-x01-y01","9.98")
for ih in range(3,9) :
    path = "/ARGUS_1988_I266892/d%02d-x01-y01"%ih
    if path not in inhistos: continue
    edges = inhistos[path][9.98].xEdges()
    nHist = yoda.BinnedEstimate1D(edges,path)
    ens = ["U1",9.98]
    for i,val in enumerate(edges) :
        if i<2 :
            bb = inhistos[path][ens[i]].bin(i+1)
            nHist.bins()[i].setVal(bb.val())
            for key in bb.sources() :
                nHist.bins()[i].setErr(bb.err(key),key)
        else :
            bbs = (inhistos[path][ens[0]].bin(1),inhistos[path][ens[1]].bin(2))
            nHist.bins()[i].setVal(0.5*(bbs[0].val()+bbs[1].val()))
            for key in bbs[0].sources() :
                err = (-0.5*np.sqrt(bbs[0].err(key)[0]**2+bbs[1].err(key)[0]**2),
                       +0.5*np.sqrt(bbs[0].err(key)[1]**2+bbs[1].err(key)[1]**2))
                nHist.bins()[i].setErr(err,key)
    outhistos[path]=nHist
